# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required - no default in settings. Supply from your secret store (e.g. Azure Key Vault).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
POSTGRES_DB=mindtrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- MindTrack rule thresholds (all optional, shown here with defaults) ---
LOW_MOOD_FAST_PATH_THRESHOLD=2
TREND_MEAN_MOOD_WINDOW_DAYS=7
TREND_MEAN_MOOD_THRESHOLD=3
TREND_CONSECUTIVE_LOW_MOOD_COUNT=3
TREND_CONSECUTIVE_LOW_MOOD_THRESHOLD=2
TREND_NO_ENTRY_STREAK_DAYS=5
